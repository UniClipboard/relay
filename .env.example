# =============================================================================
# UniClipboard Relay v2 — Shared & Service Configuration
# Copy to .env and customize before running: docker compose up -d
# =============================================================================

# -----------------------------------------------------------------------------
# Shared Credentials (used by Hyper relay and reserved for future P2P/DERP)
# -----------------------------------------------------------------------------

# Optional instance access key required in the X-Unic-Relay-Key HTTP header.
# Leave empty to allow public access without an instance key.
# For production, prefer RELAY_ACCESS_KEY_FILE with a chmod 0600 secret file.
RELAY_ACCESS_KEY=

# Optional comma-separated list of base64url-encoded 32-byte Ed25519 device
# public keys allowed to authenticate as mailbox owners (Owner Auth).
# Leave empty to allow any device public key.
RELAY_ALLOWED_PUBKEYS=

# -----------------------------------------------------------------------------
# Hyper Relay (E2EE Temporary HTTP Chunk Relay — Relay HTTP API v1)
# -----------------------------------------------------------------------------

# Host bind address and port published by Docker Compose.
# Defaults to loopback (127.0.0.1) behind your TLS reverse proxy (Caddy/Nginx).
HYPER_PUBLISH_ADDR=127.0.0.1
HYPER_PORT=8080

# Canonical public origin verified in Ed25519 Owner Auth signatures.
# Strongly recommended when running behind a reverse proxy (e.g. https://relay.example.com).
HYPER_ORIGIN=

# Maximum encrypted transfer size in bytes (default: 26214400 = 25 MiB).
HYPER_MAX_TRANSFER_BYTES=26214400

# Default and maximum transfer TTL (Go duration format; hard contract ceiling: 30m).
HYPER_DEFAULT_TTL=10m
HYPER_MAX_TTL=30m

# Per-mailbox quotas.
HYPER_MAX_SENDERS=64
HYPER_MAX_TRANSFERS=32

# SSE heartbeat interval.
HYPER_KEEPALIVE_INTERVAL=25s

# Optional temporary directory for encrypted chunk files.
# Leave empty for in-memory storage, or set to /var/lib/hyper-relay in Docker
# to avoid RAM spikes on low-memory NAS / high-concurrency hosts.
HYPER_STORAGE_DIR=

# -----------------------------------------------------------------------------
# Reserved: P2P Relay (Tailcat DERP) — Not yet implemented
# -----------------------------------------------------------------------------
# P2P_DERP_PORT=443
# P2P_STUN_PORT=3478
