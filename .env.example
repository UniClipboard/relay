# =============================================================================
# UniClipboard Relay v2 — Direct-to-S3 Configuration
# Copy to .env and configure your S3-compatible object storage before running:
#   docker compose up -d
# =============================================================================

# -----------------------------------------------------------------------------
# Shared Credentials (used by Hyper relay and reserved for future P2P/DERP)
# -----------------------------------------------------------------------------
RELAY_ACCESS_KEY=
RELAY_ALLOWED_PUBKEYS=

# -----------------------------------------------------------------------------
# Hyper Relay Control Plane
# -----------------------------------------------------------------------------
HYPER_PUBLISH_ADDR=127.0.0.1
HYPER_PORT=8080
HYPER_ORIGIN=
HYPER_MAX_TRANSFER_BYTES=26214400
HYPER_DEFAULT_TTL=10m
HYPER_MAX_TTL=30m
HYPER_MAX_SENDERS=64
HYPER_MAX_TRANSFERS=32
HYPER_KEEPALIVE_INTERVAL=25s

# -----------------------------------------------------------------------------
# S3-Compatible Object Storage (REQUIRED — Direct Client Upload & Download)
# -----------------------------------------------------------------------------
# Encrypted ciphertext chunks go directly between devices and object storage
# via short-lived SigV4 presigned URLs — zero chunk traffic hits this server.
#
# Example 1: Tencent Cloud COS
#   S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
#   S3_REGION=ap-guangzhou
#   S3_BUCKET=uniclipboard-relay-1250000000
#   S3_FORCE_PATH_STYLE=false
#
# Example 2: Cloudflare R2
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=uniclipboard-hyper-chunks
#   S3_FORCE_PATH_STYLE=true
#
# Example 3: AWS S3
#   S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
#   S3_REGION=us-east-1
#   S3_BUCKET=uniclipboard-relay-chunks
#   S3_FORCE_PATH_STYLE=false
#
# Example 4: Aliyun OSS
#   S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
#   S3_REGION=oss-cn-hangzhou
#   S3_BUCKET=uniclipboard-relay-chunks
#   S3_FORCE_PATH_STYLE=false
#
# Example 5: Local MinIO (--profile minio)
#   S3_ENDPOINT=http://minio:9000
#   S3_PUBLIC_ENDPOINT=https://s3.example.com
#   S3_REGION=us-east-1
#   S3_BUCKET=uniclipboard-relay
#   S3_FORCE_PATH_STYLE=true

S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
# Optional public HTTPS endpoint for client presigned URLs (defaults to S3_ENDPOINT).
S3_PUBLIC_ENDPOINT=
S3_REGION=ap-guangzhou
S3_BUCKET=uniclipboard-relay-1250000000
S3_ACCESS_KEY_ID=
# For production, you may alternatively mount an owner-only (0600) file and set S3_SECRET_ACCESS_KEY_FILE.
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_KEY_PREFIX=mailboxes
S3_PRESIGN_TTL=5m
