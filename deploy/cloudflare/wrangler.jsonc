// SPDX-License-Identifier: AGPL-3.0-only
// UniClipboard Hyper Relay (Direct-to-S3 Relay HTTP API v2) — Cloudflare Workers + Durable Objects
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uniclipboard-hyper-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MAILBOX_DO",
        "class_name": "MailboxDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MailboxDurableObject"]
    }
  ],
  // Non-secret runtime defaults.
  // Configure S3-compatible object storage (Tencent COS, Cloudflare R2, AWS S3, Aliyun OSS, MinIO):
  //   - Non-secret vars: S3_ENDPOINT, S3_PUBLIC_ENDPOINT (optional), S3_REGION, S3_BUCKET,
  //                      S3_FORCE_PATH_STYLE, S3_KEY_PREFIX, S3_PRESIGN_TTL_SEC
  //   - Secrets (via `wrangler secret put`):
  //                      S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, RELAY_ACCESS_KEY (optional)
  "vars": {
    "HYPER_MAX_TRANSFER_BYTES": "26214400",
    "HYPER_DEFAULT_TTL_SEC": "600",
    "HYPER_MAX_TTL_SEC": "1800",
    "HYPER_MAX_SENDERS": "64",
    "HYPER_MAX_TRANSFERS": "32",
    "HYPER_KEEPALIVE_MS": "25000",
    "S3_REGION": "auto",
    "S3_FORCE_PATH_STYLE": "false",
    "S3_KEY_PREFIX": "mailboxes",
    "S3_PRESIGN_TTL_SEC": "300"
  }
}
